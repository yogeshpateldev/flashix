{
    "name": "flashix-backend",
    "version": "1.0.0",
    "description": "Production-grade ephemeral file sharing platform backend",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/server.js",
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "lint": "eslint src/**/*.ts",
        "lint:fix": "eslint src/**/*.ts --fix",
        "format": "prettier --write src/**/*.ts",
        "typecheck": "tsc --noEmit",
        "worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
        "seed": "ts-node scripts/seed.ts",
        "docker:build": "docker build -t flashix-backend .",
        "docker:run": "docker-compose up -d",
        "docker:down": "docker-compose down"
    },
    "dependencies": {
        "@sentry/node": "^8.0.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/compression": "^1.8.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.21",
        "@types/express-rate-limit": "^5.1.3",
        "@types/hpp": "^0.2.7",
        "@types/jest": "^29.5.8",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^1.4.13",
        "@types/node": "^20.10.4",
        "@types/qrcode": "^1.5.6",
        "@types/supertest": "^2.0.16",
        "@types/uuid": "^9.0.8",
        "bcryptjs": "^2.4.3",
        "bullmq": "^4.12.7",
        "cloudinary": "^1.41.0",
        "compression": "^1.7.4",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "dotenv": "^17.3.1",
        "express": "^4.18.2",
        "express-mongo-sanitize": "^2.2.0",
        "express-rate-limit": "^7.1.5",
        "express-validator": "^7.0.1",
        "helmet": "^7.1.0",
        "hpp": "^0.2.3",
        "joi": "^17.13.3",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.0.3",
        "multer": "^1.4.5-lts.1",
        "nanoid": "^3.3.7",
        "prom-client": "^15.0.0",
        "qrcode": "^1.5.3",
        "rate-limit-redis": "^4.2.0",
        "redis": "^4.6.11",
        "typescript": "^5.3.3",
        "uuid": "^9.0.1",
        "winston": "^3.11.0",
        "xss-clean": "^0.1.4"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^6.13.1",
        "@typescript-eslint/parser": "^6.13.1",
        "eslint": "^8.55.0",
        "husky": "^8.0.3",
        "jest": "^29.7.0",
        "lint-staged": "^15.2.0",
        "mongodb-memory-server": "^11.0.1",
        "prettier": "^3.1.0",
        "supertest": "^6.3.3",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.0",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.1",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^4.2.0"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=8.0.0"
    },
    "keywords": [
        "file-sharing",
        "ephemeral",
        "nodejs",
        "typescript",
        "express",
        "mongodb",
        "redis",
        "cloudinary"
    ],
    "author": "Flashix Team",
    "license": "MIT"
}
