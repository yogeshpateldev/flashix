# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration (disabled for local testing)
MONGO_URI=mongodb://localhost:27017/drop24
REDIS_URL=redis://localhost:6379

# Cloudinary Configuration (demo values)
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abc123def456

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_minimum_32_characters_long
JWT_REFRESH_SECRET=super_secret_refresh_key_minimum_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_SECRET=super_secret_session_key_minimum_32_characters_long

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ANON=20
RATE_LIMIT_MAX_USER=100
RATE_LIMIT_MAX_UPLOAD=5

# File Upload Configuration
MAX_UPLOAD_SIZE=104857600
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Monitoring & Observability
SENTRY_DSN=https://dummy@dummy.ingest.sentry.io/dummy
PROMETHEUS_PORT=9090

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Worker Configuration
BULLMQ_REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=10

# File Expiration (in hours)
DEFAULT_EXPIRY_HOURS=24
MAX_EXPIRY_HOURS=168

# Security Headers
TRUST_PROXY=true
FORCE_HTTPS=false
